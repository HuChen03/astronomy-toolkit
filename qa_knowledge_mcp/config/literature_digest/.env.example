# Literature hub
LITERATURE_HUB_BASE_URL=http://127.0.0.1:8080
LITERATURE_HUB_TIMEOUT_SECONDS=120

# Daily near-24-hour catalog: previous 08:00 to current 08:00
LDA_DISCIPLINE=cond-mat
LDA_DAILY_FETCH_LIMIT=500
LDA_DATABASE_PATH=data/literature_digest/literature_digest.sqlite3
LDA_TIMEZONE=Asia/Shanghai
LDA_CUTOFF_HOUR=8
LDA_KEYWORDS_PATH=examples/literature_digest/keywords.json

# Model classification selects one predefined category
LDA_ENABLE_LLM_CLASSIFICATION=true
LDA_MAX_WORKERS=4
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=120

# MCP server
LDA_MCP_TRANSPORT=streamable-http
LDA_MCP_HOST=127.0.0.1
LDA_MCP_PORT=8000
LDA_MCP_ADMIN_TOKEN=
