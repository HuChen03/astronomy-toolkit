# The existing QA JSONL corpus. Paths are resolved from this directory when relative.
QA_SOURCE=data/cosmological_simulation/generate_paper.jsonl
# Optional normalized index generated by qa-knowledge-build.
QA_INDEX=data/cosmological_simulation/index
QA_KNOWLEDGE_BASE_CONFIG=config/knowledge_bases
QA_MCP_TRANSPORT=streamable-http
QA_MCP_HOST=0.0.0.0
QA_MCP_PORT=8001
LDA_MCP_TRANSPORT=streamable-http
LDA_MCP_HOST=0.0.0.0
LDA_MCP_PORT=8002

# Production retrieval. Defaults to BAAI/bge-small-zh-v1.5 + FAISS if the model
# dependencies are installed and the model is available locally/downloadable.
QA_ENABLE_EMBEDDING=false
QA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
QA_EMBEDDING_DEVICE=cpu
QA_EMBEDDING_BATCH_SIZE=8
# Optional cross-encoder reranker, for example BAAI/bge-reranker-base.
# QA_RERANK_MODEL=BAAI/bge-reranker-base
# QA_ENABLE_RERANKER=true

# Literature digest integration.
LITERATURE_HUB_BASE_URL=
LITERATURE_HUB_TIMEOUT_SECONDS=120
LDA_DISCIPLINE=cond-mat
LDA_DAILY_FETCH_LIMIT=500
LDA_DATABASE_PATH=data/literature_digest/literature_digest.sqlite3
LDA_TIMEZONE=Asia/Shanghai
LDA_CUTOFF_HOUR=8
LDA_KEYWORDS_PATH=examples/literature_digest/keywords.json
LDA_ENABLE_LLM_CLASSIFICATION=true
LDA_MAX_WORKERS=4

# Optional email / LLM settings for the daily digest agent.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=

# Optional provider settings for offline paper processing.
# API_URL=
# API_KEY=
# MODEL=
# QA_PROCESSED_PAPERS_ROOT=data/knowledge_acquisition/processed_papers
